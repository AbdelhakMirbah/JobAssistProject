# ─────────────────────────────────────────────────────────────────────────────
# JobAssist — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite database path (optional — defaults to ./jobassist.db)
DATABASE_URL=sqlite:///./jobassist.db

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Email Sending (Phase 3) ───────────────────────────────────────────────────
# Your Gmail address (or any SMTP sender)
EMAIL_ADDRESS=yourname@gmail.com

# Gmail App Password (NOT your account password!)
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here

# SMTP server settings (Gmail defaults shown)
# SMTP server settings (Gmail defaults shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── OmniRoute AI Gateway (Phase 3+) ──────────────────────────────────────────
# OmniRoute = FREE MIT gateway: 359 providers, 150+ free tiers, ~1.62B tokens/month
# Install:  npm install -g omniroute
# Start:    omniroute          (boots at http://localhost:20128)
# Docs:     https://github.com/diegosouzapw/OmniRoute

# Set to true to use OmniRoute instead of (or as fallback to) Gemini
USE_OMNIROUTE=false

# OmniRoute server URL (default: http://localhost:20128)
OMNIROUTE_URL=http://localhost:20128

# OmniRoute model selection:
#   auto          → balanced (recommended — auto-picks best free provider)
#   auto/coding   → quality-first for code generation
#   auto/fast     → lowest latency
#   auto/cheap    → cheapest per token
#   auto/offline  → maximum quota headroom (best for batch jobs)
OMNIROUTE_MODEL=auto

