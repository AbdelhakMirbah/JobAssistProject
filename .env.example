# ─────────────────────────────────────────────────────────────────────────────
# JobAssist — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite database path (optional — defaults to ./jobassist.db)
DATABASE_URL=sqlite:///./jobassist.db

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Email Sending (Phase 3) ───────────────────────────────────────────────────
# Your Gmail address (or any SMTP sender)
EMAIL_ADDRESS=yourname@gmail.com

# Gmail App Password (NOT your account password!)
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here

# SMTP server settings (Gmail defaults shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
