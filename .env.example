# ========================================================
# Job Assistant n8n - Environment Configuration
# ========================================================

# 1. AI Engine Configuration (gemini or ollama)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# 2. Telegram Bot Configuration (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your Chat ID by messaging @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Firebase Configuration
# Download serviceAccountKey.json from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=/data/credentials/serviceAccountKey.json

# 4. n8n Configuration
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_random_32_character_string_here

# 5. Gotenberg PDF Service
GOTENBERG_PORT=3000

# 6. Job Search Configuration (JobSpy / Indeed)
JOB_SEARCH_TERMS=Junior Software Engineer,Software Engineer,Junior Data Engineer,Data Engineer,Développeur Full Stack,Développeur Mobile
JOB_LOCATION=Morocco
JOB_COUNTRY=morocco
